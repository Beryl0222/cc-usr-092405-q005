{
  "项目名称": "跨文化内容共制",
  "参与角色": [
    "版权方",
    "文化顾问",
    "制片团队",
    "青年创作者",
    "发行负责人"
  ],
  "核心对象": [
    "原始IP",
    "文化元素",
    "改编提案",
    "成片版本",
    "授权合同",
    "按市场授权(授权窗口)",
    "素材(演员/音乐/视觉)",
    "领料记录",
    "工时记录",
    "交付记录(内容哈希)",
    "译审文化复核",
    "当地分级",
    "发行渠道",
    "发行副本",
    "汇率版本(按结算日)",
    "结算批次",
    "结算行(外部流水)",
    "差异争议",
    "争议审批",
    "退款/更正账目",
    "隔离收入"
  ],
  "提案状态": ["提案中", "已采纳", "已驳回"],
  "文化元素立场": [
    "allowed（可使用）",
    "restricted（受限：仅受限市场清单内不允许）",
    "forbidden（禁用：全部市场）"
  ],
  "素材确认状态": ["unconfirmed", "confirmed", "rejected"],
  "授权状态": ["active", "withdrawn"],
  "交付状态": ["accepted", "duplicate"],
  "版本状态": [
    "制作中",
    "复核未过",
    "就绪",
    "已发行",
    "已阻断",
    "已下线"
  ],
  "发行副本状态": ["blocked（未发布/被阻断）", "online（在线）", "taken_down（已下架）"],
  "结算行类型": ["sale（销售）", "refund（退款，负向追加）", "adjustment（更正，只追加）"],
  "结算行状态": ["imported（已入账可分配）", "quarantined（撤回边界后隔离）", "duplicate（外部流水重复，不重复入账）"],
  "争议状态": ["open（未决，市场可分配余额冻结）", "approved（制作方与权利方双批准，已释放）", "resolved（更正后差异消除）", "rejected（任一批准方拒绝，维持冻结）"],
  "财务口径": [
    "应收：平台报表口径金额（receivable，按结算日汇率折本位币）",
    "实收：平台实际回款金额（received，按结算日汇率折本位币）",
    "可支付：实收按上线时冻结分成比例分配到各方后的余额；争议未决时市场整体冻结",
    "汇率：按结算日版本化，(币种, 结算日) 一经结算行引用即不可改写",
    "隔离：收入周期末日晚于授权撤回日的结算行单独隔离，不参与分配"
  ],
  "发行三关": [
    "权利关：IP级授权必备；素材级授权仅在素材进入成片时要求；按市场+授权窗口核验",
    "文化关：译审复核通过且版本不含禁用/在该市场受限的元素",
    "分级关：已取得该市场当地分级"
  ],
  "参考状态_旧": ["提案中", "尽调中", "制作中", "待发行", "已下线"],
  "说明": "字段仅用于统一领域称谓，业务记录应由正式接口（POST /actions）产生。"
}
